#!/usr/bin/env node

const path = require('path');
const fs = require('fs-extra');

const TEMPLATE_DIR = 'lib/assets';

// コピー対象から除外するディレクトリ名
// .agents      : .claude/skills から常に再生成するため、テンプレート側の実体は持ち込まない
// node_modules : 依存は利用者が package.json から復元する
const EXCLUDED_DIRS = ['.agents', 'node_modules'];

/**
 * コピー除外対象かどうかを判定する.
 * @param {string} srcRoot コピー元のルート
 * @param {string} from コピー元のパス
 * @returns {boolean} 除外するなら true
 */
function isExcluded(srcRoot, from) {
  const relative = path.relative(srcRoot, from);
  if (!relative) {
    return false;
  }
  return relative.split(path.sep).some((segment) => EXCLUDED_DIRS.includes(segment));
}

async function setupProject() {
  // プロジェクトのルートディレクトリのパスを取得する
  const projectDir = process.env.INIT_CWD || process.cwd();

  // パッケージのルートディレクトリのパスを取得する
  const packageDir = path.join(__dirname, '..');

  // テンプレートファイルが含まれるディレクトリのパスを取得する
  const templateDir = path.join(packageDir, TEMPLATE_DIR);

  // コマンドライン引数の解析
  const args = process.argv.slice(2);
  const isUpdate = args.includes('--update');

  try {
    if (isUpdate) {
      // --update オプション時は .claude と docs 配下のみ上書きコピー
      const targets = ['.claude', 'docs', '.devcontainer'];
      for (const dir of targets) {
        const src = path.join(templateDir, dir);
        const dest = path.join(projectDir, dir);
        if (await fs.pathExists(src)) {
          await fs.ensureDir(dest);

          // 生成物は除外する。docs は加えて直下の index.md をすべて除外する
          const copyOptions = {
            overwrite: true,
            errorOnExist: false,
            filter: (from, to) => {
              if (isExcluded(src, from)) {
                return false;
              }
              if (dir === 'docs' && path.basename(from) === 'index.md') {
                return false;
              }
              return true;
            },
          };

          await fs.copy(src, dest, copyOptions);
          if (dir === 'docs') {
            console.log('[claude-code-booster] Updated "docs" (excluding docs/index.md)');
          } else {
            console.log(`[claude-code-booster] Updated "${dir}" from "${src}" to "${dest}"`);
          }
        } else {
          console.warn(`[claude-code-booster] Skip: source not found "${src}"`);
        }
      }

      // ルート直下の設定ファイルも上書きコピー
      const rootFiles = ['AGENTS.md', 'CLAUDE.md', 'Dockerfile'];
      for (const file of rootFiles) {
        const src = path.join(templateDir, file);
        const dest = path.join(projectDir, file);
        if (await fs.pathExists(src)) {
          await fs.copy(src, dest, { overwrite: true, errorOnExist: false });
          console.log(`[claude-code-booster] Updated "${file}"`);
        }
      }
    } else {
      // それ以外は assets 全体をコピー（生成物は除外）
      await fs.copy(templateDir, projectDir, {
        overwrite: true,
        errorOnExist: false,
        filter: (from, to) => !isExcluded(templateDir, from),
      });
      console.log(`[claude-code-booster] Copied assets from "${templateDir}" to "${projectDir}"`);
    }

    // .agents ディレクトリに skills をコピー
    const skillsSrc = path.join(templateDir, '.claude', 'skills');
    if (await fs.pathExists(skillsSrc)) {
      const skillsDest = path.join(projectDir, '.agents', 'skills');
      await fs.ensureDir(skillsDest);
      await fs.copy(skillsSrc, skillsDest, { overwrite: true, errorOnExist: false });
      console.log('[claude-code-booster] Copied skills to ".agents/skills"');
    }
  } catch (err) {
    console.error('[claude-code-booster] Asset copy failed:', err);
    process.exitCode = 1;
    return;
  }

  // 追加のセットアップ処理があればここに記述
}

setupProject();